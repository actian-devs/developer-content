# Copy this file to .env and provide the key only immediately before an approved live run.
OPENAI_API_KEY=

ASTRA_MODEL_ID=gpt-6-astra
ASTRA_REASONING_EFFORT=low
ASTRA_VERBOSITY=low
ASTRA_PROCESSING_TIER=standard
ASTRA_PROJECT_BUDGET_USD=8.50
ASTRA_MAX_INPUT_TOKENS=272000

VECTORAI_URL=http://localhost:16573
VECTORAI_GRPC_URL=localhost:16574
VECTORAI_COLLECTION=astra_codebase_memory
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_HOME=.cache/huggingface
